# Copy this file to `.env.local` and adjust. Files ending in `.local` are not committed.

# true  -> the UI uses the built-in mock data (no backend needed)
# false -> the UI calls the real 63yil-api backend
VITE_USE_MOCKS=true

# Base URL of the backend API. Leave as /api in development (Vite proxies it to localhost:8080).
VITE_API_BASE_URL=/api
